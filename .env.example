# 服务端口
PORT=3008

# AbuseIPDB API Keys (多个 key 轮询使用，逗号分隔)
ABUSEIPDB_KEYS=your_key_1,your_key_2,your_key_3

# iplocate.io API Key
IPLOCATE_API_KEY=your_iplocate_api_key_here

# ip2location.io API Key (留空则使用免费额度，每天 1000 次)
IP2LOCATION_API_KEY=your_ip2location_api_key_here

# 管理后台密码
ADMIN_PASSWORD=admin123

# Nominatim 联系邮箱 (可选，用于 User-Agent 标识)
NOMINATIM_EMAIL=your-email@example.com

# GitHub Token (可选，仅私有仓库后台在线更新需要，用于访问 Release API)
GITHUB_TOKEN=
